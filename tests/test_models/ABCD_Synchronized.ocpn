  "functions": [
    {
      "id": "cd742883-e6c5-42bc-bda4-2ee47cbbe9c9",
      "name": "union",
      "code": "fn union(list1, list2) {\n    let result = list1.extract(0,list1.len);\n\n    for item in list2 {\n        if !result.contains(item) {\n            result.push(item);\n        }\n    }\n\n    return result\n}"
    },
    {
      "id": "8422bf2c-42f2-4cb1-8536-2e75d9d37a73",
      "name": "in1",
      "code": "fn in1(value, list) {\n    for tuple in list {\n        if tuple[0] == value {\n            return true;\n        }\n    }\n    false\n}"
    },
    {
      "id": "660608f9-9c1c-4bbc-8886-a979b25313d2",
      "name": "in2",
      "code": "fn in2(value, list) {\n    for tuple in list {\n        if tuple[1] == value {\n            return true;\n        }\n    }\n    false\n}"
    },
    {
      "id": "7e09f4b7-51f8-4c15-95f0-ea9ce792b506",
      "name": "remove1",
      "code": "fn remove1(value, list) {\n    let result = [];\n\n    for tuple in list {\n        if tuple[0] != value {\n            result.push(tuple);\n        }\n    }\n\n    result\n}"
    },
    {
      "id": "70c1502c-e6cc-4a39-b9c2-c5ea674949e7",
      "name": "remove2",
      "code": "fn remove2(value, list) {\n    let result = [];\n\n    for tuple in list {\n        if tuple[1] != value {\n            result.push(tuple);\n        }\n    }\n\n    result\n}"
    }
  ],
