  "functions": [
    {
      "id": "union",
      "name": "union",
      "code": "\nfn union(list1, list2) {\n    let result = list1.extract(0,list1.len);\n\n    for item in list2 {\n        if !result.contains(item) {\n            result.push(item);\n        }\n    }\n\n    return result\n}\n            "
    },
    {
      "id": "in1",
      "name": "in1",
      "code": "\nfn in1(value, list) {\n    for tuple in list {\n        if tuple[0] == value {\n            return true;\n        }\n    }\n    false\n}\n            "
    },
    {
      "id": "in2",
      "name": "in2",
      "code": "\nfn in2(value, list) {\n    for tuple in list {\n        if tuple[1] == value {\n            return true;\n        }\n    }\n    false\n}\n            "
    },
    {
      "id": "remove1",
      "name": "remove1",
      "code": "\nfn remove1(values, list) {\n    let result = [];\n    for tuple in list {\n        if tuple[0] !in values {\n            result.push(tuple);\n        }\n    }\n    result\n}\n            "
    },
    {
      "id": "remove2",
      "name": "remove2",
      "code": "\nfn remove2(values, list) {\n    let result = [];\n    for tuple in list {\n        if tuple[1] !in values {\n            result.push(tuple);\n        }\n    }\n    result\n}\n            "
    },
    {
      "id": "getPairs",
      "name": "getPairs",
      "code": "\nfn getPairs(list1, list2) {\n    let result = [];\n\n    for item1 in list1 {\n        for item2 in list2 {\n            result.push([item1, item2]);\n        }\n    }\n\n    result\n}\n            "
    },
    {
      "id": "exists1",
      "name": "exists1",
      "code": "\nfn exists1(list1, list_tuples) {\n    for x in list1 {\n        for tuple in list_tuples {\n            if tuple[0] == x {\n                return true;\n            }\n        }\n    }\n\n    false\n}\n                "
    },
    {
      "id": "exists2",
      "name": "exists2",
      "code": "\nfn exists2(list1, list_tuples) {\n    for x in list1 {\n        for tuple in list_tuples {\n            if tuple[1] == x {\n                return true;\n            }\n        }\n    }\n\n    false\n}\n                "
    },
    {
      "id": "allPairExists",
      "name": "allPairExists",
      "code": "\nfn allPairExists(x_list, y_list, s_tuples) {\n    for x_prime in x_list {\n        for y_prime in y_list {\n            if !s_tuples.contains([x_prime, y_prime]) {\n                return false;\n            }\n        }\n    }\n\n    true\n}\n                "
    },
    {
      "id": "imp",
      "name": "imp",
      "code": "\nfn imp(a, b) {\n    !a || b;\n}\n                "
    }
  ],
